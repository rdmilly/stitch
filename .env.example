# Database
DATABASE_URL=postgresql+asyncpg://stitch:your_password@db:5432/stitch
REDIS_URL=redis://redis:6379/0

# URLs
FRONTEND_URL=https://stitch.yourdomain.com
BACKEND_URL=https://stitch-api.yourdomain.com

# Security
SECRET_KEY=generate-a-random-32-char-string
JWT_SECRET_KEY=generate-another-random-32-char-string

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://stitch-api.yourdomain.com/api/auth/linkedin/callback

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key
